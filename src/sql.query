-- Option 2: If you must have RLS enabled, run this to allow all operations
CREATE POLICY "Enable all operations for all users" ON public.quotation_items
FOR ALL
USING (true)
WITH CHECK (true);

-- From fix_stuck_database.sql --
-- Bas ye ek line run kijiye:
CREATE INDEX IF NOT EXISTS idx_quotation_items_quotation_id ON public.quotation_items(quotation_id);

-- From fix_thumbnails.sql --
ALTER TABLE public.quotation_items ADD COLUMN IF NOT EXISTS thumbnail text; UPDATE public.quotation_items qi SET thumbnail = item->>'thumbnail' FROM public.quotation q, jsonb_array_elements(q.details->'items') AS item WHERE qi.quotation_id = q.id AND qi.item_code = item->>'itemCode' AND item->>'thumbnail' IS NOT NULL;

-- From fix_timeout.sql --
CREATE INDEX IF NOT EXISTS idx_quotation_items_quotation_id ON public.quotation_items(quotation_id);

-- From migrate_quotation_items_table.sql --
CREATE TABLE IF NOT EXISTS public.quotation_items (
  id text not null,
  quotation_id text null,
  item_type text null default 'item',
  item_code text null,
  description text null,
  quantity numeric null default 0,
  unit_price numeric null default 0,
  discount_percent numeric null default 0,
  tax_percent numeric null default 0,
  net_amount numeric null default 0,
  add_discount numeric null default 0,
  constraint quotation_items_pkey primary key (id),
  constraint quotation_items_quotation_id_fkey foreign KEY (quotation_id) references quotation (id) on delete CASCADE
) TABLESPACE pg_default;

-- Migrate existing items from the JSON details column into the new quotation_items table
INSERT INTO public.quotation_items (
  id, quotation_id, item_type, item_code, description, 
  quantity, unit_price, discount_percent, tax_percent, net_amount, add_discount
)
SELECT 
  COALESCE(NULLIF(item->>'id', ''), gen_random_uuid()::text),
  q.id,
  COALESCE(item->>'type', 'item'),
  item->>'itemCode',
  item->>'description',
  COALESCE(NULLIF(item->>'quantity', ''), '0')::numeric,
  COALESCE(NULLIF(item->>'unitPrice', ''), '0')::numeric,
  COALESCE(NULLIF(item->>'discountPercent', ''), '0')::numeric,
  COALESCE(NULLIF(item->>'taxPercent', ''), '0')::numeric,
  COALESCE(NULLIF(item->>'netAmount', ''), '0')::numeric,
  COALESCE(NULLIF(item->>'addDiscount', ''), '0')::numeric
FROM public.quotation q,
jsonb_array_elements(q.details->'items') AS item
WHERE q.details IS NOT NULL AND q.details->'items' IS NOT NULL
ON CONFLICT (id) DO NOTHING;

-- From migrate_quotations.sql --
ALTER TABLE public.quotation ADD COLUMN IF NOT EXISTS customer_address text, ADD COLUMN IF NOT EXISTS customer_area_pin_code text, ADD COLUMN IF NOT EXISTS customer_city_state text, ADD COLUMN IF NOT EXISTS customer_state text, ADD COLUMN IF NOT EXISTS customer_email text, ADD COLUMN IF NOT EXISTS customer_mobile text, ADD COLUMN IF NOT EXISTS validity_date text, ADD COLUMN IF NOT EXISTS price_list text, ADD COLUMN IF NOT EXISTS payment_terms text, ADD COLUMN IF NOT EXISTS gross_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS discount_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS tax_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS round_off_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS total_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_code text, ADD COLUMN IF NOT EXISTS item_description text, ADD COLUMN IF NOT EXISTS item_quantity numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_unit_price numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_discount_percent numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_tax_percent numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_net_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_add_discount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS type_of_quotation text;

UPDATE public.quotation 
SET 
  customer_address = details->'basicInfo'->>'address', 
  customer_area_pin_code = details->'basicInfo'->>'areaPinCode', 
  customer_city_state = details->'basicInfo'->>'cityState', 
  customer_state = COALESCE(details->'basicInfo'->>'state', details->'otherInfo'->>'state'), 
  customer_email = details->'basicInfo'->>'email', 
  customer_mobile = COALESCE(details->'basicInfo'->>'mobile', details->'otherInfo'->>'mobile'), 
  validity_date = details->'basicInfo'->>'validityDate', 
  price_list = details->'basicInfo'->>'priceList', 
  payment_terms = details->'basicInfo'->>'paymentTerms', 
  type_of_quotation = details->'basicInfo'->>'typeOfQuotation', 
  gross_amount = COALESCE(NULLIF(details->'summary'->>'grossAmount', ''), '0')::numeric, 
  discount_amount = COALESCE(NULLIF(details->'summary'->>'discountAmount', ''), '0')::numeric, 
  tax_amount = COALESCE(NULLIF(details->'summary'->>'taxAmount', ''), '0')::numeric, 
  round_off_amount = COALESCE(NULLIF(details->'summary'->>'roundOffAmount', ''), '0')::numeric, 
  total_amount = COALESCE(NULLIF(details->'summary'->>'totalAmount', ''), '0')::numeric, 
  item_code = details->'items'->0->>'itemCode', 
  item_description = details->'items'->0->>'description', 
  item_quantity = COALESCE(NULLIF(details->'items'->0->>'quantity', ''), '0')::numeric, 
  item_unit_price = COALESCE(NULLIF(details->'items'->0->>'unitPrice', ''), '0')::numeric, 
  item_discount_percent = COALESCE(NULLIF(details->'items'->0->>'discountPercent', ''), '0')::numeric, 
  item_tax_percent = COALESCE(NULLIF(details->'items'->0->>'taxPercent', ''), '0')::numeric, 
  item_net_amount = COALESCE(NULLIF(details->'items'->0->>'netAmount', ''), '0')::numeric, 
  item_add_discount = COALESCE(NULLIF(details->'items'->0->>'addDiscount', ''), '0')::numeric
WHERE details IS NOT NULL AND details != '{}'::jsonb;

-- From alter_quotation.sql --
ALTER TABLE public.quotation ADD COLUMN IF NOT EXISTS customer_address text, ADD COLUMN IF NOT EXISTS customer_area_pin_code text, ADD COLUMN IF NOT EXISTS customer_city_state text, ADD COLUMN IF NOT EXISTS customer_state text, ADD COLUMN IF NOT EXISTS customer_email text, ADD COLUMN IF NOT EXISTS customer_mobile text, ADD COLUMN IF NOT EXISTS validity_date text, ADD COLUMN IF NOT EXISTS price_list text, ADD COLUMN IF NOT EXISTS payment_terms text, ADD COLUMN IF NOT EXISTS gross_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS discount_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS tax_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS round_off_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS total_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_code text, ADD COLUMN IF NOT EXISTS item_description text, ADD COLUMN IF NOT EXISTS item_quantity numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_unit_price numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_discount_percent numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_tax_percent numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_net_amount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS item_add_discount numeric DEFAULT 0, ADD COLUMN IF NOT EXISTS type_of_quotation text;

-- Add UOM column to item table --
ALTER TABLE public.item ADD COLUMN IF NOT EXISTS uom text;
