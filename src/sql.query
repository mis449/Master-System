);

-- ──────────────────────────────────────────────
--  QUOTATION NORMALIZATION  (DB normalization)
--  Replaces the flat details JSONB + item_* cols
-- ──────────────────────────────────────────────

-- 1. Basic customer / quotation info
CREATE TABLE public.quotation_basic_info (
  id            bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  quotation_id  text NOT NULL,
  customer      text,
  address       text,
  validity_date text,
  price_list    text,
  payment_terms text,
  city_state    text,
  email         text,
  mobile        text,
  area_pin_code text,
  type_of_quotation text,
  created_at    timestamp with time zone DEFAULT now(),
  CONSTRAINT quotation_basic_info_pkey PRIMARY KEY (id),
  CONSTRAINT quotation_basic_info_quotation_id_fkey
    FOREIGN KEY (quotation_id) REFERENCES public.quotation(id) ON DELETE CASCADE
);

-- 2. Other / internal info
CREATE TABLE public.quotation_other_info (
  id                   bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  quotation_id         text NOT NULL,
  sales_person         text,
  sales_number         text,
  quort_person         text,
  quort_mobile         text,
  reference_number     text,
  customer_reference   text,
  expected_delivery_date text,
  internal_notes       text,
  mobile               text,
  state                text,
  created_at           timestamp with time zone DEFAULT now(),
  CONSTRAINT quotation_other_info_pkey PRIMARY KEY (id),
  CONSTRAINT quotation_other_info_quotation_id_fkey
    FOREIGN KEY (quotation_id) REFERENCES public.quotation(id) ON DELETE CASCADE
);

-- 3. Notes / remarks
CREATE TABLE public.quotation_notes (
  id                   bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  quotation_id         text NOT NULL,
  remarks              text,
  terms_and_conditions text,
  additional_notes     text,
  created_at           timestamp with time zone DEFAULT now(),
  CONSTRAINT quotation_notes_pkey PRIMARY KEY (id),
  CONSTRAINT quotation_notes_quotation_id_fkey
    FOREIGN KEY (quotation_id) REFERENCES public.quotation(id) ON DELETE CASCADE
);

-- 4. Financial summary
CREATE TABLE public.quotation_summary (
  id               bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  quotation_id     text NOT NULL,
  gross_amount     numeric DEFAULT 0,
  discount_amount  numeric DEFAULT 0,
  tax_amount       numeric DEFAULT 0,
  round_off_amount numeric DEFAULT 0,
  total_amount     numeric DEFAULT 0,
  created_at       timestamp with time zone DEFAULT now(),
  CONSTRAINT quotation_summary_pkey PRIMARY KEY (id),
  CONSTRAINT quotation_summary_quotation_id_fkey
    FOREIGN KEY (quotation_id) REFERENCES public.quotation(id) ON DELETE CASCADE
);

-- 5. Line items  (one row per item — replaces single item_* columns)
CREATE TABLE public.quotation_items (
  id               text NOT NULL,
  quotation_id     text NOT NULL,
  item_type        text DEFAULT 'item',
  item_code        text,
  description      text,
  quantity         numeric DEFAULT 0,
  unit_price       numeric DEFAULT 0,
  discount_percent numeric DEFAULT 0,
  add_discount     numeric DEFAULT 0,
  tax_percent      numeric DEFAULT 0,
  net_amount       numeric DEFAULT 0,
  thumbnail        text,
  sort_order       integer DEFAULT 0,
  created_at       timestamp with time zone DEFAULT now(),
  CONSTRAINT quotation_items_pkey PRIMARY KEY (id),
  CONSTRAINT quotation_items_quotation_id_fkey
    FOREIGN KEY (quotation_id) REFERENCES public.quotation(id) ON DELETE CASCADE
);

